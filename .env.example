# Шаблон, который коммитится. Реальные значения — в .env, он в .gitignore.
#
# Адрес TSLA на Robinhood Chain. НЕ МЕНЯТЬ: в сети есть токены-двойники
# с идентичными именем "Tesla • Robinhood Token" и символом TSLA.
# Настоящий — 30k+ холдеров и иконка с cdn.robinhood.com.
TSLA_ADDRESS=0x322F0929c4625eD5bAd873c95208D54E1c003b2d

RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Холодный ключ на аппаратном кошельке. Никогда не попадает на сервер.
ADMIN_ADDRESS=

# Горячий ключ воркера. Публикует корни, доступа к средствам не имеет.
KEEPER_ADDRESS=

# Стартовый потолок прироста аллокации на один корень, в wei.
MAX_ALLOCATION_INCREASE=

# Приватный ключ деплоера. НИКОГДА не коммитить заполненным.
DEPLOYER_PRIVATE_KEY=

# Адрес RewardVault, который печатает script/DeployRewardVault.s.sol.
REWARD_VAULT=
