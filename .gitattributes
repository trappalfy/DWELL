# Force LF in the working tree. forge fmt and solc expect LF; on Windows git
# would otherwise check out CRLF, which makes every line read as modified and
# keeps `forge fmt --check` permanently red.
* text=auto eol=lf

# Vendored dependencies: keep exactly as published, no normalization.
lib/** -text

# Self-hosted fonts: binary, never line-ending normalized. `text=auto` guesses
# right most of the time, and a font it guesses wrong on is a corrupt file.
*.ttf binary
*.otf binary
*.woff2 binary
